<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:KillPort.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="450"
        x:Class="KillPort.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Width="600" Height="450"
        Title="KillPort - Cross Platform Process Killer">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <!-- Main Layout -->
    <Panel>
    <Grid RowDefinitions="Auto, *, Auto" Margin="20">
        
        <!-- Top: Search Section -->
        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,20">
            <TextBox Grid.Column="0" 
                     Text="{Binding SearchPort}" 
                     Watermark="Enter Port Number (e.g. 8080)"
                     FontSize="16"
                     Margin="0,0,10,0">
                <TextBox.KeyBindings>
                    <KeyBinding Gesture="Enter" Command="{Binding SearchCommand}" />
                </TextBox.KeyBindings>
            </TextBox>
            <Button Grid.Column="1" 
                    Command="{Binding SearchCommand}"
                    Content="Search"
                    FontSize="16"
                    Padding="20,5"
                    Background="{DynamicResource SystemControlHighlightAccentBrush}"
                    Foreground="White"/>
        </Grid>

        <!-- Middle: Process List -->
        <Border Grid.Row="1" 
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" 
                BorderThickness="1" 
                CornerRadius="4"
                Padding="0">
            <DataGrid ItemsSource="{Binding ProcessList}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      GridLinesVisibility="All"
                      BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Port" 
                                        Binding="{Binding Port}" 
                                        Width="Auto"/>
                    <DataGridTextColumn Header="PID" 
                                        Binding="{Binding ProcessId}" 
                                        Width="Auto"/>
                    <DataGridTextColumn Header="Process Name" 
                                        Binding="{Binding ProcessName}" 
                                        Width="*"/>
                    <DataGridTextColumn Header="Protocol" 
                                        Binding="{Binding Protocol}" 
                                        Width="Auto"/>
                    <DataGridTemplateColumn Header="Action" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Kill"
                                        HorizontalAlignment="Center"
                                        Command="{Binding $parent[DataGrid].((vm:MainWindowViewModel)DataContext).RequestKillProcessCommand}"
                                        CommandParameter="{Binding}"
                                        Background="#FF4D4D"
                                        Foreground="White"
                                        Padding="10,2"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Bottom: Status Bar -->
        <TextBlock Grid.Row="2" 
                   Text="{Binding StatusMessage}" 
                   Margin="0,10,0,0"
                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                   FontSize="12"/>
    </Grid>

        <!-- Confirmation Overlay -->
        <Grid Background="#99000000" 
              IsVisible="{Binding IsConfirmationVisible}">
            <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" 
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MinWidth="300">
                <StackPanel Spacing="15">
                    <TextBlock Text="Confirm Kill Process" 
                               FontSize="18" 
                               FontWeight="Bold"/>
                    <TextBlock Text="Are you sure you want to kill this process?" 
                               TextWrapping="Wrap"/>
                     <TextBlock Text="{Binding ProcessToKill.ProcessName, StringFormat='Process: {0}'}" 
                                FontWeight="SemiBold"/>
                     <TextBlock Text="{Binding ProcessToKill.ProcessId, StringFormat='PID: {0}'}" 
                                FontSize="12"
                                Foreground="Gray"/>
                    
                    <StackPanel Orientation="Horizontal" 
                                HorizontalAlignment="Right" 
                                Spacing="10">
                        <Button Content="Cancel" 
                                Command="{Binding CancelKillCommand}"/>
                        <Button Content="Yes, Kill" 
                                Background="#FF4D4D" 
                                Foreground="White"
                                Command="{Binding ConfirmKillCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Panel>

</Window>
